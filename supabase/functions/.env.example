# Peak Story Studio — Edge Function secrets.
# Copy to supabase/functions/.env.local. That file is git-ignored; never commit it.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform (confirmed locally via `docker exec <edge-runtime container>
# env`). Never add them here, and never put a service-role key — or an S3
# secret below — in a VITE_ variable.

# Cloudflare Turnstile. These are Cloudflare's published test keys: they need no
# account and always pass, so local development runs with the captcha genuinely
# enabled. Replace both with real keys before deploying.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Any non-empty string. Changing it invalidates existing rate-limit buckets.
# The local value below is fine for development, but MUST be replaced with a
# real, secret value before deploying: unset (or reused across environments),
# the ledger's ip_hash becomes sha256(":" + ip) — brute-forceable across the
# whole IPv4 space in seconds, which defeats the point of hashing at all.
RATE_LIMIT_SALT=local-development-salt
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_MINUTES=60

# Resend. Leave blank locally: the function then skips email and records
# notification_status='skipped' rather than failing the inquiry.
RESEND_API_KEY=
RESEND_FROM=
STUDIO_NOTIFY_EMAIL=

# Comma-separated CORS allowlist. Blank means allow any origin, which is fine
# locally. Phase 4 sets this to the real domain.
ALLOWED_ORIGINS=

# sign-upload's S3 target. One code path signs against local Supabase storage
# and Cloudflare R2 in production — see supabase/functions/_shared/s3-presign.js
# — so only these five values change between environments.
#
# Locally, `supabase status -o env` prints STORAGE_S3_URL and the
# S3_PROTOCOL_* credentials. Use STORAGE_S3_URL exactly as printed —
# `http://127.0.0.1:54321/storage/v1/s3` — do NOT swap in the Edge Function
# container's internal hostname (`kong:8000`) even though SUPABASE_URL
# *inside* the function is exactly that. The difference is what the value is
# for: SUPABASE_URL is dialled by code running inside the container (so it
# needs the container-network hostname), but S3_ENDPOINT is never dialled by
# this function at all — presignPut is pure computation, no network call —
# it is only ever embedded in the URL string handed back to the BROWSER,
# which cannot resolve `kong` (a Docker-internal name) and has to reach
# storage the same way it reaches every other local Supabase port. Verified
# directly: a URL signed with `kong:8000` as the host comes back
# `SignatureDoesNotMatch` from local storage even from *inside* the Docker
# network (tested via another container's native DNS), while the identical
# request signed with `127.0.0.1:54321` succeeds. See the Task 4 report for
# the full diagnostic.
#   S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3   (STORAGE_S3_URL, verbatim)
#   S3_REGION=local                                     (S3_PROTOCOL_REGION)
#   S3_ACCESS_KEY_ID=<S3_PROTOCOL_ACCESS_KEY_ID>
#   S3_SECRET_ACCESS_KEY=<S3_PROTOCOL_ACCESS_KEY_SECRET>
# S3_BUCKET is not printed by `supabase status`; it names the private bucket
# created for this phase (see the Task 4 report for how and why "media").
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Ceiling on the declared size of a signed upload, in bytes. Optional —
# sign-upload defaults to 15 MiB (15728640) when unset or invalid. Images are
# resized and re-encoded to WebP in the browser before this is ever called,
# so a legitimate upload sits far under either value.
MAX_UPLOAD_BYTES=15728640

# Storage endpoint for functions that DIAL storage themselves (delete-media)
# rather than embedding it in a URL for the browser (sign-upload). Locally
# the browser-reachable S3_ENDPOINT above is 127.0.0.1 — which, from inside
# the edge runtime, is the container itself. The working local value goes
# out to the machine and back in through Kong (host.docker.internal), NOT an
# in-network shortcut: the local storage API validates the S3 signature
# against the host Kong forwards, so kong:8000 and the storage container
# both fail with SignatureDoesNotMatch (verified live). Leave unset in
# production — R2's public endpoint is dialable from everywhere, and
# S3_ENDPOINT then serves both roles. (host.docker.internal is a Docker
# Desktop name; on plain Linux docker use the host's bridge IP instead.)
S3_INTERNAL_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3
